# Use the Vercel project origin in production until a custom domain is configured.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
MATTERZERO_ADMIN_EMAIL=admin@example.com
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Server-only Supabase Postgres connection string. Use the transaction pooler for Vercel.
DATABASE_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
# Optional product analytics. Use the public project token and ingest host from your PostHog project.
# Leave both empty to disable analytics. Use a separate PostHog project for local testing.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
