    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
